# ========== 阶段一：基础环境 ==========
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./database/eduagent.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== 讯飞星火（密钥只写在 .env，勿提交 Git）==========
# 模型路由由后端 AVAILABLE_MODELS 自动处理，以下为凭据配置：
#
# | 模型           | 协议      | 说明                                    |
# |---------------|-----------|----------------------------------------|
# | Spark-X2-Flash| WebSocket | 高速推理，适合日常对话（默认）              |
# | Spark-X2      | WebSocket | 深度推理模型，综合能力更强                  |
# | lite          | HTTP      | 免费轻量版，适合开发测试                    |
# | generalv3     | HTTP      | Spark Pro，性价比高                       |
# | generalv3.5   | HTTP      | Spark Max，结构化抽取与推理能力强            |
#
SPARK_API_TYPE=websocket
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_WS_URL=wss://spark-api.xf-yun.com/x2
SPARK_DOMAIN=spark-x
SPARK_TIMEOUT=120

# HTTP 开放接口凭据（Lite/Pro/Max 使用，APIPassword）
SPARK_API_PASSWORD=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=Spark-X2-Flash

# ========== 讯飞 ASR 语音识别（阶段七）==========
# 前往 https://console.xfyun.cn/services/iat 创建应用
ASR_APP_ID=
ASR_API_KEY=
ASR_API_SECRET=
ASR_WS_URL=wss://raasr.xfyun.cn/v2/recognize

# ========== 讯飞 TTS 语音合成（阶段七）==========
# 前往 https://console.xfyun.cn/services/tts 创建应用
# 在线语音合成（流式）API 地址：ws://tts-api.xfyun.com/v2/tts
# 常用音色：xiaoyan（通用女声，已开启）、x4_xiaoyuan、x4_xiaozhi、x4_xiaomei、x4_xiaomeng
# 更多音色请在控制台查看：https://www.xfyun.cn/doc/tts/online_tts/API.html
TTS_APP_ID=
TTS_API_KEY=
TTS_API_SECRET=
TTS_WS_URL=wss://tts-api.xfyun.cn/v2/tts

# ========== 阶段二：RAG 知识库 ==========
KNOWLEDGE_DIR=./knowledge
CHROMA_PERSIST_DIR=./vector_db/chroma
CHROMA_COLLECTION=eduagent_courses
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOP_K=4
AUTO_INGEST_ON_STARTUP=false

# ========== 阶段三：学生画像 ==========
PROFILE_CACHE_TTL=3600
